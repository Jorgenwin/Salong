# Miljøvariabler for backend v1 (se docs/decisions/0001-backend-v1.md).
# Frontend-prototypen bruker INGEN av disse: den har ingen hemmeligheter og skal aldri få noen.
# Kopier til .env (som er ignorert av git) og fyll inn på serveren. Aldri commit verdier.

# --- Server ---
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# --- Database (fase 2) ---
# Runtime-databasen. Bruk en egen utviklings-/produksjonsdatabase per miljø.
DATABASE_URL=
# Kun for eksplisitte integrasjonstester. Skal aldri peke på produksjonsdatabasen.
TEST_DATABASE_URL=

# --- Autentisering (fase 2) ---
AUTH_SECRET=

# --- Integrasjoner, KUN serverside (fase 2) ---
APOLLO_API_KEY=
EXA_API_KEY=
ANTHROPIC_API_KEY=            # Spør Salong og tekstutkast (i dag via Claude-artefaktens `sample`)
FIRECRAWL_API_KEY=

# --- E-post (fase 3; Salong sender ikke e-post i dag, bare utkast) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=

# --- Booking (fase 3) ---
BOOKING_API_URL=
BOOKING_API_KEY=
