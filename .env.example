# Miljøvariabler for backend v1 (se docs/decisions/0001-backend-v1.md).
# Frontend-prototypen bruker INGEN av disse: den har ingen hemmeligheter og skal aldri få noen.
# Kopier til .env (som er ignorert av git) og fyll inn på serveren. Aldri commit verdier.

# --- Server ---
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# --- Database (fase 2) ---
# Runtime-databasen. Bruk en egen utviklings-/produksjonsdatabase per miljø.
DATABASE_URL=
# Kun for eksplisitte integrasjonstester. Skal aldri peke på produksjonsdatabasen.
TEST_DATABASE_URL=

# --- Supabase Auth (kun API-server, ikke secrets i repo) ---
# AUTH_SECRET alene aktiverer IKKE innlogging.
AUTH_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Kun for engangsprovisjonering av eier, se docs/supabase-auth.md
SALONG_OWNER_AUTH_SUBJECT=
SALONG_OWNER_NAME=
SALONG_OWNER_EMAIL=

# --- Integrasjoner, KUN serverside (fase 2) ---
APOLLO_API_KEY=
EXA_API_KEY=
ANTHROPIC_API_KEY=            # Spør Salong og research-uttrekk, kun serverside
ANTHROPIC_MODEL=claude-sonnet-5 # kan overstyres ved runtime-wiring
FIRECRAWL_API_KEY=

# --- E-post (fase 3; Salong sender ikke e-post i dag, bare utkast) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=

# --- Booking (fase 3) ---
BOOKING_API_URL=
BOOKING_API_KEY=

# --- Enrichment worker ---
WORKER_ID=
WORKER_HEARTBEAT_MS=30000
WORKER_STALE_SECONDS=900
